
pipeline {
    agent any

    stages {

        // Stage 1: Code Checkout
        stage('Code Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Repository Name: django-todo-cicd"

                    echo "Repository URL:"
                    git remote get-url origin

                    echo "Current Branch:"
                    git name-rev --name-only HEAD

                    echo "Workspace Files:"
                    ls -la
                '''
            }
        }

        // Stage 2: Build
        stage('Build') {
            agent {
                docker {
                    image 'python:3.9-slim'
                    args '-u root'
                }
            }

            steps {
                echo 'Installing Django dependencies...'

                sh 'python -m pip install --no-cache-dir django==3.2'

                echo 'Checking Django application...'

                sh 'python manage.py check'

                echo 'Django application check completed successfully.'
            }
        }

        // Stage 3: Deploy Two Containers
        stage('Deploy') {
            steps {
                echo 'Building Docker image...'

                // Remove old containers if they exist
                sh 'docker rm -f todo_container1 todo_container2 || true'

                // Build one Docker image
                sh 'docker build -t todo .'

                // Start first container on port 8000
                echo 'Starting first container...'

                sh 'docker run -d -p 8000:8000 --name todo_container1 todo'

                // Start second container on port 8001
                echo 'Starting second container...'

                sh 'docker run -d -p 8001:8000 --name todo_container2 todo'

                // Verify both containers
                echo 'Verifying both containers...'

                sh 'docker ps'
            }

            post {
                always {
                    echo 'Waiting for 2 minutes...'

                    sleep 120

                    echo 'Stopping both containers...'

                    sh 'docker stop todo_container1 todo_container2 || true'

                    echo 'Removing both containers...'

                    sh 'docker rm todo_container1 todo_container2 || true'

                    echo 'Both containers stopped and removed.'
                }
            }
        }
    }

    // Pipeline Post Actions
    post {
        success {
            echo 'Pipeline executed successfully'
        }

        failure {
            echo 'Pipeline execution failed'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
