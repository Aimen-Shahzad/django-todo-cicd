
pipeline {
    agent any

    stages {

        stage('Code Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Repository Name: django-todo-cicd"

                    echo "Repository URL:"
                    git remote get-url origin

                    echo "Current Branch:"
                    git name-rev --name-only HEAD

                    echo "Workspace Files:"
                    ls -la
                '''
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'python:3.9-slim'
                    args '-u root'
                }
            }

            steps {
                echo 'Installing Django dependencies...'

                sh 'python -m pip install --no-cache-dir django==3.2'

                echo 'Checking Django application...'

                sh 'python manage.py check'

                echo 'Django application check completed successfully.'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Building Docker image...'

                sh 'docker rm -f todo_container || true'

                sh 'docker build -t todo .'

                sh 'docker run -d -p 8000:8000 --name todo_container todo'

                echo 'Container deployed successfully.'

                sh 'docker ps'
            }

            post {
                always {
                    echo 'Waiting for 2 minutes...'

                    sleep 120

                    echo 'Stopping container...'

                    sh 'docker stop todo_container || true'

                    echo 'Removing container...'

                    sh 'docker rm todo_container || true'

                    echo 'Container cleanup completed.'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully'
        }

        failure {
            echo 'Pipeline execution failed'
        }

        always {
            echo 'Pipeline execution completed'
        }
    }
}
